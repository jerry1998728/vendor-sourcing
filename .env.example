# Copy to .env.local (gitignored). All values are read server-side only;
# never import them into client components.

# Anthropic Messages API: web search (web_search_20250305), extraction,
# email drafting and reply inference.
ANTHROPIC_API_KEY=

# GitHub token for the githubOrg adapter (read access to public repos is enough).
GITHUB_TOKEN=

# Gmail OAuth desktop-client JSON downloaded from Google Cloud (gitignored).
# token.json is written to the repo root after the first auth.
GMAIL_CREDENTIALS_PATH=credentials.json

# Comma-separated addresses outreach is allowed to send to.
# Any other recipient is rejected server-side.
DEMO_ALLOWED_RECIPIENTS=you+test@example.com

# Optional
# ANTHROPIC_MODEL=            # force one model for every task (testing only); default routing is haiku for extraction, sonnet for drafting/inference
# ANTHROPIC_WEB_SEARCH_TOOL=  # web_search_20260209 to use the newer search tool variant
# LLM_DISCOVER_EFFORT=low     # effort on models that support it
# LLM_EXTRACT_EFFORT=medium
# DATABASE_PATH=data/vendor-sourcing.db
